   cmp #32
+  .endif
   bne sw_ns_wrapdone
   lda #0
   sta st_vary
@@ -2055,9 +2085,19 @@ sw_rw_shadow_nohi:
   lda sw_rw_arow
   cmp #8
   bne sw_rw_arow_loop
+  .if STREAM_RING
+  lda sw_rw_nt
+  clc
+sw_ring_nt_step:
+  adc #SW_RW_NT_STEP
+  sta sw_rw_nt
+sw_ring_nt_end:
+  cmp #SW_RW_NT_END
+  .else
   inc sw_rw_nt
   lda sw_rw_nt
   cmp #4
