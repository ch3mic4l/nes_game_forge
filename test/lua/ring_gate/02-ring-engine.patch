diff --git a/a/engine/streamworld.asm b/b/engine/streamworld.asm
index 663372b..24c538e 100644
--- a/a/engine/streamworld.asm
+++ b/b/engine/streamworld.asm
@@ -1571,10 +1571,20 @@ sw_ssc_store:
   inc sw_probe_row_screen
 sw_ssc_noadv:
   lda ss_i
+  .if STREAM_RING
+sw_ring_col_cmp:
+  cmp #SW_RING_COL_LEN
+  .else
   cmp #30
+  .endif
   bne sw_ssc_loop
   jsr sw_locate_current        ; restore the CURRENT (player) screen
+  .if STREAM_RING
+sw_ring_col_len:
+  lda #SW_RING_COL_LEN
+  .else
   lda #30
+  .endif
   sta st_len
   lda #0
   sta st_cur
@@ -1668,10 +1678,20 @@ sw_ssr_store:
   inc sw_probe_col_screen
 sw_ssr_noadv:
   lda ss_i
+  .if STREAM_RING
+sw_ring_row_cmp:
+  cmp #SW_RING_ROW_LEN
+  .else
   cmp #32
+  .endif
   bne sw_ssr_loop
   jsr sw_locate_current
+  .if STREAM_RING
+sw_ring_row_len:
+  lda #SW_RING_ROW_LEN
+  .else
   lda #32
+  .endif
   sta st_len
   lda #0
   sta st_cur
@@ -1708,14 +1728,24 @@ sw_ns_loop:
   cmp #1
   bne sw_ns_wrap32
   lda st_vary
+  .if STREAM_RING
+sw_ring_wrap_col:
