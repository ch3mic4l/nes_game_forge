-- sw_battle_return_check.lua.template -- Mesen (real, independent core) proof of a streamed RPG
-- screen's own battle-return lifecycle: fix round 2 (review round 3 of 3, finding A6/C1)'s
-- explicitly required "Mesen battle-return/guard check and failing negative control".
--
-- test/unit/streamworldlifecycle.test.js's own Part B already proves this exhaustively against
-- the vendored jsnes core (window/camera resync, screen_fresh re-settle, entity-restoration
-- identity, strip cancellation). This script drives the SAME scenario -- a one-hit-kill monster
-- and a bystander marker NPC on a streamed RPG screen -- through Mesen's real core instead, via
-- REAL scripted pad input against the real battle menu (bt_sel/bt_phase, not a poked command),
-- and watches the position-jump guard (engine/streamworld.asm's sw_position_jump_guard) for the
-- whole run: a battle-return regression that made the window merely "eventually correct" via the
-- guard's own redundant safety net, rather than directly, would still read as a functional win in
-- jsnes but should not pass here silently.
--
-- Generated by build_sw_battle_return_roms.mjs, which substitutes every double-underscore
-- placeholder below from that exact build's own build/constants.asm and game.fns. Do not
-- hand-edit the generated .lua -- edit this template.
--
--   Mesen --testRunner <outDir>/sw_battle_return_check.lua <outDir>/battle_return.nes

local GAME_STATE          = __GAME_STATE__
local FLAT_SCREEN         = __FLAT_SCREEN__
local MAP_IS_STREAMED     = __MAP_IS_STREAMED__
local SCREEN_FRESH        = __SCREEN_FRESH__
local PLAYER_X            = __PLAYER_X__
local PLAYER_Y            = __PLAYER_Y__
local ENT_ACTIVE          = __ENT_ACTIVE__
local ENT_ACTOR           = __ENT_ACTOR__
local ENT_X               = __ENT_X__
local ENT_Y               = __ENT_Y__
local MAX_ENTITIES        = __MAX_ENTITIES__
local ST_ACTIVE           = __ST_ACTIVE__
local WIN_COL_SCREEN      = __WIN_COL_SCREEN__
local WIN_COL_LOCAL       = __WIN_COL_LOCAL__
local WIN_ROW_SCREEN      = __WIN_ROW_SCREEN__
local WIN_ROW_LOCAL       = __WIN_ROW_LOCAL__
local SW_CAM_ORIGIN_X_LO  = __SW_CAM_ORIGIN_X_LO__
local SW_CAM_ORIGIN_X_HI  = __SW_CAM_ORIGIN_X_HI__
local SW_CAM_ORIGIN_Y_LO  = __SW_CAM_ORIGIN_Y_LO__
local SW_CAM_ORIGIN_Y_HI  = __SW_CAM_ORIGIN_Y_HI__
local BT_PHASE            = __BT_PHASE__
local BT_SEL              = __BT_SEL__
local BP_MENU             = __BP_MENU__
local BC_FIGHT            = __BC_FIGHT__
local ST_BATTLE           = __ST_BATTLE__
local ST_GAMEPLAY         = __ST_GAMEPLAY__
local SW_POSITION_JUMP_GUARD = __SW_POSITION_JUMP_GUARD__

local MONSTER_ACTOR_ID = __MONSTER_ACTOR_ID__
local MARKER_ACTOR_ID  = __MARKER_ACTOR_ID__
local MONSTER_X = __MONSTER_X__
local MONSTER_Y = __MONSTER_Y__
local MARKER_X = __MARKER_X__
local MARKER_Y = __MARKER_Y__
local BREAK_MODE = __BREAK_MODE__

local EXIT_TIMEOUT              = 99
local EXIT_NO_BOOT              = 2
local EXIT_NOT_STREAMED         = 3
local EXIT_NO_BATTLE            = 4
local EXIT_BATTLE_NEVER_ENDED   = 5
local EXIT_NO_RESUME            = 6
local EXIT_UNEXPECTED_GUARD_FIRE = 7
local EXIT_SCREEN_FRESH_MISSING = 8
local EXIT_STRIP_ARMED          = 9
local EXIT_WINDOW_NOT_CONTAINED = 10
local EXIT_RESTORATION_IDENTITY = 11

local frame = 0
local phase = 'boot'
local mark = 0
local held = {}
local pjgFireCount = 0
local reported = false

local function log(message)
  print(string.format("[%5d][%s] %s", frame, phase, message))
end

local finished = false

local function fail(code, message)
  if finished then return end
  finished = true
  log("FAIL: " .. message)
  emu.stop(code)
end

local function pass(message)
  log("ok   " .. message)
end

local function read(address)
  return emu.read(address, emu.memType.nesMemory)
end

local function write(address, value)
  emu.write(address, value, emu.memType.nesMemory)
end

local function onInput()
  emu.setInput(held, 0)
end

local function onPositionJumpGuardEntry()
  pjgFireCount = pjgFireCount + 1
end

-- Fix round 2 (finding A6/C1): the lifecycle guard-silence obligation. A battle-return regression
-- that only "eventually" produces a correct window via the guard's own redundant emergency resync
-- (Part E, streamworldlifecycle.test.js) is not the same as the direct battle_end -> redraw_screen
-- resync this check exists to prove -- so a fire anywhere in this run fails it outright, the
-- instant it happens rather than only at the end, so the log names the exact frame.
emu.addMemoryCallback(function()
  if finished then return end
  onPositionJumpGuardEntry()
  fail(EXIT_UNEXPECTED_GUARD_FIRE, string.format(
    "the position-jump guard fired at frame %d during a normal battle-entry/return sequence -- the window's own resync must come directly from battle_end/redraw_screen, not from the guard's own redundant emergency correction",
    frame))
end, emu.callbackType.exec, SW_POSITION_JUMP_GUARD)

local function checkRestoration()
  local ok = true
  local monsterSlot, markerSlot = -1, -1
  for i = 0, MAX_ENTITIES - 1 do
    if read(ENT_ACTIVE + i) ~= 0 then
      local actor = read(ENT_ACTOR + i)
      if actor == MONSTER_ACTOR_ID then monsterSlot = i end
      if actor == MARKER_ACTOR_ID then markerSlot = i end
    end
  end
  if monsterSlot ~= -1 then
    fail(EXIT_RESTORATION_IDENTITY, string.format("the defeated monster (actorId %d) is still active in slot %d after a WIN -- it must be gone", MONSTER_ACTOR_ID, monsterSlot))
    return false
  end
  if markerSlot == -1 then
    fail(EXIT_RESTORATION_IDENTITY, string.format("the untouched marker NPC (actorId %d) is not active after the battle -- it must still be standing", MARKER_ACTOR_ID))
    return false
  end
  -- Fix round 3, finding 3: identity alone would equally pass a mutation that corrupts the
  -- survivor's own RESTORED position while leaving ent_active/ent_actor untouched (the same gap
  -- test/unit/streamworldlifecycle.test.js's own win/flee/scripted-Fight tests were strengthened
  -- against this round) -- check the marker's restored position against its own authored spawn.
  local markerX, markerY = read(ENT_X + markerSlot), read(ENT_Y + markerSlot)
  if markerX ~= MARKER_X or markerY ~= MARKER_Y then
    fail(EXIT_RESTORATION_IDENTITY, string.format("the marker NPC (actorId %d, slot %d) restored to position (%d,%d), not its own authored spawn (%d,%d)", MARKER_ACTOR_ID, markerSlot, markerX, markerY, MARKER_X, MARKER_Y))
    return false
  end
  pass(string.format("restoration identity confirmed: monster (actorId %d) gone, marker (actorId %d) still active in slot %d at its authored position (%d,%d)", MONSTER_ACTOR_ID, MARKER_ACTOR_ID, markerSlot, markerX, markerY))
  return true
end

local function onMaskWrite(address, value)
  if finished then return end
  if phase ~= 'awaitResume' then return end
  if (value & 0x18) == 0 then return end -- only a real enable, not the disable half of the pair
  if read(GAME_STATE) ~= ST_GAMEPLAY then return end
  if reported then return end
  reported = true

  if read(SCREEN_FRESH) ~= 1 then
    fail(EXIT_SCREEN_FRESH_MISSING, "screen_fresh must already be set at the exact frame battle-return rendering resumes")
    return
  end
  pass("screen_fresh confirmed set at the first real resumed display-enable")

  if read(ST_ACTIVE) ~= 0 then
    fail(EXIT_STRIP_ARMED, "battle return must not leave a strip armed at the first resumed display")
    return
  end
  pass("strip cancellation confirmed: st_active == 0 at the first resumed display")

  local camPx = read(SW_CAM_ORIGIN_X_LO) | (read(SW_CAM_ORIGIN_X_HI) << 8)
  local camPy = read(SW_CAM_ORIGIN_Y_LO) | (read(SW_CAM_ORIGIN_Y_HI) << 8)
  local visLoX, visHiX = math.floor(camPx / 16), math.floor((camPx + 255) / 16)
  local visLoY, visHiY = math.floor(camPy / 16), math.floor((camPy + 239) / 16)
  local colBlock = read(WIN_COL_SCREEN) * 16 + read(WIN_COL_LOCAL)
  local rowBlock = read(WIN_ROW_SCREEN) * 15 + read(WIN_ROW_LOCAL)
  if visLoX < colBlock or visHiX > colBlock + 31 or visLoY < rowBlock or visHiY > rowBlock + 29 then
    fail(EXIT_WINDOW_NOT_CONTAINED, string.format(
      "battle return: visible range (X %d-%d, Y %d-%d) is not contained in the resynced window (col block %d, row block %d)",
      visLoX, visHiX, visLoY, visHiY, colBlock, rowBlock))
    return
  end
  pass("full window resync confirmed: visible range contained in the resynced window at the first resumed display")

  -- battle_end's own ent_active clear (engine/rpg.asm) runs strictly AFTER `jsr redraw_screen`
  -- returns -- textually and temporally after the display-enable write just caught above, which
  -- happens INSIDE that call (sw_render_window's own final step). So the clear itself is checked
  -- one frame later, not at this exact display-enable instant -- the identical timing
  -- test/unit/streamworldlifecycle.test.js's own Part B already established and comments on.
  phase = 'checkRestoration'
  mark = frame
end

local function finishUp()
  if not checkRestoration() then return end

  if pjgFireCount ~= 0 then
    -- Already failed synchronously above the instant it happened; this is unreachable in
    -- practice, kept only as a defensive second check.
    fail(EXIT_UNEXPECTED_GUARD_FIRE, string.format("the position-jump guard fired %d time(s) during this run", pjgFireCount))
    return
  end
  pass("position-jump guard silent throughout the whole battle-entry/return sequence")

  pass(string.format("battle-return lifecycle check PASSED (break=%s)", tostring(BREAK_MODE)))
  finished = true
  emu.stop(0)
end

local function onFrame()
  if finished then return end
  frame = frame + 1

  if frame > 3000 then
    fail(EXIT_TIMEOUT, "timed out in phase " .. phase)
    return
  end

  if phase == 'boot' then
    local ready = read(GAME_STATE) == ST_GAMEPLAY and read(MAP_IS_STREAMED) == 1
    if not ready then
      if frame >= 400 then
        if read(GAME_STATE) ~= ST_GAMEPLAY then
          fail(EXIT_NO_BOOT, "never reached ST_GAMEPLAY within 400 frames")
        else
          fail(EXIT_NOT_STREAMED, "reached ST_GAMEPLAY but map_is_streamed never became 1 within 400 frames -- the landing screen never engaged streaming")
        end
      end
      return
    end
    pass("boot reached ST_GAMEPLAY on a streamed RPG map")
    -- Teleport straight onto the monster's own position -- entity_touching_player fires from the
    -- ordinary entity loop on the very next tick regardless of how the player got there, exactly
    -- as camera_check.lua.template's own direct player-position poke does for a screen crossing.
    write(PLAYER_X, MONSTER_X)
    write(PLAYER_Y, MONSTER_Y)
    phase = 'approach'
    mark = frame
    return
  end

  if phase == 'approach' then
    if read(GAME_STATE) == ST_BATTLE then
      pass("touch_encounter fired: a real battle has started")
      phase = 'menu'
      mark = frame
      return
    end
    if frame - mark >= 60 then
      fail(EXIT_NO_BATTLE, "walking onto the monster never started a battle within 60 frames")
    end
    return
  end

  if phase == 'menu' then
    if read(GAME_STATE) == ST_GAMEPLAY then
      pass("the battle ended -- gameplay resumed")
      held = {}
      phase = 'awaitResume'
      mark = frame
      return
    end
    if frame - mark >= 300 then
      fail(EXIT_BATTLE_NEVER_ENDED, "the battle never ended within 300 frames of starting")
      return
    end
    -- A real Down/A pulse every 14 frames (test/unit/streamworldlifecycle.test.js's own tap()
    -- cadence): Down until the real bt_sel byte reads BC_FIGHT, A otherwise -- which both commits
    -- the FIGHT command once selected and advances every subsequent message/animation phase, the
    -- same "just keep tapping A" shape the unit test's own chooseCommand+tap loop uses.
    local sincePulse = (frame - mark) % 14
    if sincePulse == 0 then
      if read(BT_PHASE) == BP_MENU and read(BT_SEL) ~= BC_FIGHT then
        held = { down = true }
      else
        held = { a = true }
      end
    else
      held = {}
    end
    return
  end

  if phase == 'awaitResume' then
    if frame - mark >= 100 and not reported then
      fail(EXIT_NO_RESUME, "battle return never reached its own real display-enable write within 100 frames of the battle ending")
    end
    return
  end

  if phase == 'checkRestoration' then
    if frame - mark >= 1 then
      finishUp()
    end
    return
  end
end

emu.addEventCallback(onFrame, emu.eventType.endFrame)
emu.addEventCallback(onInput, emu.eventType.inputPolled)
emu.addMemoryCallback(onMaskWrite, emu.callbackType.write, 0x2001)
