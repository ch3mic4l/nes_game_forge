-- sw_talker_battle.lua.template -- Mesen (real, independent core) replay of ONE pinned L5 case: a streamed RPG scene whose talker page crosses a seam with a scripted Move,
-- fights a scripted Battle (real Down/A pulses against the real battle menu), and runs to the end of its page. It prints ONE `RESULT {json}` line of what the engine did
-- (variables, switch 0, the four talker bytes, the talker's slot arrays, every entry of the self-command handlers); node asserts the expectations written in
-- test/lua/sw_talker_battle.mjs (hand-written from the design, never read back from this output). Generated by sw_talker_battle.mjs: do not hand-edit the .lua.
local GAME_STATE, MAP_IS_STREAMED = __GAME_STATE__, __MAP_IS_STREAMED__
local SCRIPT_ACTIVE, PENDING_ENT, BOX_STATE = __SCRIPT_ACTIVE__, __PENDING_ENT__, __BOX_STATE__
local BT_SEL, BT_PHASE, BP_MENU, BC_FIGHT = __BT_SEL__, __BT_PHASE__, __BP_MENU__, __BC_FIGHT__
local VARIABLES, SWITCHES = __VARIABLES__, __SWITCHES__
local TALK_REC, TALK_SCR, TALK_CROSSED, OWED, TALK_ENT = __TALK_REC__, __TALK_SCR__, __TALK_CROSSED__, __OWED__, __TALK_ENT__
local ENT_ACTIVE, ENT_RECORD, ENT_DIR, ENT_Y, MAX_ENTITIES = __ENT_ACTIVE__, __ENT_RECORD__, __ENT_DIR__, __ENT_Y__, __MAX_ENTITIES__
local TALKER_RECORD = __TALKER_RECORD__
local HANDLERS = { __HANDLERS__ }
local ST_GAMEPLAY, ST_BATTLE = 0, 5
local NO = 255

local frame, phase, idle, held, entries, since = 0, 'boot', 0, {}, {}, 0
local finished = false

local function read(a) return emu.read(a, emu.memType.nesMemory) end
local function slotOf(rec)
  for i = 0, MAX_ENTITIES - 1 do if read(ENT_ACTIVE + i) ~= 0 and read(ENT_RECORD + i) == rec then return i end end
  return -1
end
for _, h in ipairs(HANDLERS) do
  emu.addMemoryCallback(function()
    entries[#entries + 1] = string.format('{"h":%d,"talkEnt":%d,"slot":%d,"crossed":%d}', h, read(TALK_ENT), slotOf(TALKER_RECORD), read(TALK_CROSSED))
  end, emu.callbackType.exec, h)
end

local function finish(code, why)
  if finished then return end
  finished = true
  local vars = {}
  for i = 0, 7 do vars[#vars + 1] = read(VARIABLES + i) end
  local slot = slotOf(TALKER_RECORD)
  print(string.format('RESULT {"why":"%s","frames":%d,"vars":[%s],"sw0":%d,"rec":%d,"scr":%d,"crossed":%d,"owed":%d,"ent":%d,"slot":%d,"slotDir":%d,"slotActive":%d,"slotY":%d,"state":%d,"entries":[%s]}',
    why, frame, table.concat(vars, ','), read(SWITCHES) & 1, read(TALK_REC), read(TALK_SCR), read(TALK_CROSSED), read(OWED), read(TALK_ENT),
    slot, slot >= 0 and read(ENT_DIR + slot) or -1, slot >= 0 and read(ENT_ACTIVE + slot) or -1, slot >= 0 and read(ENT_Y + slot) or -1, read(GAME_STATE), table.concat(entries, ',')))
  emu.stop(code)
end

local function onInput() emu.setInput(held, 0) end

local function onFrame()
  if finished then return end
  frame = frame + 1
  if frame > 6000 then finish(99, 'timeout in ' .. phase) return end
  if phase == 'boot' then
    if read(GAME_STATE) == ST_GAMEPLAY and read(MAP_IS_STREAMED) == 1 then phase = 'script' elseif frame > 400 then finish(2, 'no boot') end
    return
  end
  if phase == 'script' then
    -- the talker page starts on its own (an enter trigger on the start screen); drive it as test/lib/streamedcross.js drive() does
    if read(SCRIPT_ACTIVE) == 1 then phase = 'drive' elseif frame > 900 then finish(3, 'the talker page never started') end
    return
  end
  if phase == 'drive' then
    held = {}
    since = since + 1
    if read(GAME_STATE) == ST_BATTLE then
      idle = 0
      if since % 14 == 0 then
        if read(BT_PHASE) == BP_MENU and read(BT_SEL) ~= BC_FIGHT then held = { down = true } else held = { a = true } end
      end
      return
    end
    local box = read(BOX_STATE)
    -- a confirm press only while a message box is up and waiting (3 = page wait, 6 = end wait): a press during a bare script would end the event
    if (box == 3 or box == 6) and since % 6 == 0 then held = { a = true } end
    if read(SCRIPT_ACTIVE) == 0 and read(GAME_STATE) == ST_GAMEPLAY and read(PENDING_ENT) == NO then idle = idle + 1 else idle = 0 end
    if idle >= 24 then phase = 'tail'; since = 0 end
    return
  end
  if phase == 'tail' then
    since = since + 1
    if since >= 60 then finish(0, 'settled') end -- nothing may fire late either
  end
end

emu.addEventCallback(onFrame, emu.eventType.endFrame)
emu.addEventCallback(onInput, emu.eventType.inputPolled)
