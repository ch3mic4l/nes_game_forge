-- sw_render_check.lua.template -- phase 2 slice 2b, Part I: real window-render parity.
--
-- TEMPLATE, not run directly -- test/lua/build_sw_render_roms.mjs instantiates it, substituting
-- __PLACEHOLDER__ tokens resolved fresh out of that exact build's own constants.asm/config.inc
-- (frame_cnt/game_state/ST_GAMEPLAY/map_is_streamed/cam_nt/cam_x_lo/cam_y_lo) plus an INDEPENDENT
-- oracle computed straight from the project JSON that built the ROM (expected tile ids, expected
-- palette bytes, the expected physical scroll, the nametable/attribute PPU addresses to read) --
-- never by reading back what the ROM itself wrote. See build_sw_render_roms.mjs's own header for
-- the oracle's own per-block window mapping (fix round 1: a landing's window can have a genuinely
-- nonzero local offset on either axis, so a single physical nametable can hold blocks from more
-- than one authored screen) and for --break=old-top-left-landing, the negative control that reverts
-- the ENGINE (not the oracle) to the pre-"landing"-slice top-left-only window.
--
-- Fix round 1, finding 1: the check now runs at the real display-enable boundary -- the FIRST
-- $2001 write that turns rendering on (bits $18) while map_is_streamed is already 1 -- caught via
-- emu.addMemoryCallback(..., emu.callbackType.write, 0x2001), synchronously, before any later
-- frame's ordinary per-frame camera tracking can run and repair a wrong initial publication. This
-- replaces the old "wait until frame 60, then read whatever the nametables currently hold" gate,
-- which could not tell a correct initial publication from one that only became correct a few
-- frames later. The published physical scroll itself (cam_x_lo, cam_y_lo, cam_nt) is now asserted
-- directly against the independently-computed expected values, not merely used to pick which
-- nametable to read -- a landing that installs the right window but leaves the scroll registers at
-- their own boot-clear default is nametable-content-invisible (panning is orthogonal to content)
-- but must still fail here.
--
-- block_checks covers EVERY metatile block (16x15) of all four physical nametables, and
-- attr_checks covers EVERY attribute byte (8x8) of all four -- including the one genuine
-- attribute-boundary limitation of this design (the last attribute row's bottom-half quadrants are
-- unconditionally zero, since a nametable's own 15 block-rows have no even pairing and attribute
-- bytes never span nametables).
--
--   node test/lua/build_sw_render_roms.mjs [outDir] [--break=blank-landing-tile|old-top-left-landing]
--   Mesen --testRunner <outDir>/sw_render_check.lua <outDir>/sw_render.nes
--
-- Boot-sanity gate (frame_cnt advances) reuses sw_quadrant_check.lua.template's own two-sample
-- technique verbatim -- "did the mechanism run" before correctness -- and stays a fallback,
-- independent of the display-enable hook above: if rendering is simply never turned on while
-- streamed (or game_state never reaches ST_GAMEPLAY), a frame-based timeout still fails explicitly
-- rather than hanging.

local frame_cnt        = __FRAME_CNT__
local game_state       = __GAME_STATE__
local ST_GAMEPLAY      = __ST_GAMEPLAY__
local map_is_streamed  = __MAP_IS_STREAMED__
local cam_nt            = __CAM_NT__
local cam_x_lo          = __CAM_X_LO__
local cam_y_lo          = __CAM_Y_LO__
local expected_cam_nt   = __EXPECTED_CAM_NT__
local expected_cam_x_lo = __EXPECTED_CAM_X_LO__
local expected_cam_y_lo = __EXPECTED_CAM_Y_LO__

local block_checks = __BLOCK_CHECKS__
local attr_checks = __ATTR_CHECKS__

local EXIT_TIMEOUT          = 99
local EXIT_NO_BOOT          = 2
local EXIT_BAD_STATE        = 3
local EXIT_WRONG_STREAMED   = 4
local EXIT_WRONG_RENDER     = 5
local EXIT_NO_RENDER_ENABLE = 6

local frame = 0
local baselineFrameCnt = nil
local checked = false
local previousMask = 0

local function log(message) emu.log(message) end
local function fail(code, message) log("FAIL: " .. message) emu.stop(code) end
local function pass(message) log("ok   " .. message) end
local function readCpu(address) return emu.read(address, emu.memType.nesMemory) end
local function readPpu(address) return emu.read(address, emu.memType.nesPpuMemory) end

local function decodeQuadrants(byte)
  return string.format("tl=%d tr=%d bl=%d br=%d", byte & 0x3, (byte >> 2) & 0x3, (byte >> 4) & 0x3, (byte >> 6) & 0x3)
end

local function checkRender()
  if readCpu(map_is_streamed) ~= 1 then
    fail(EXIT_WRONG_STREAMED, string.format("map_is_streamed is %d, not 1 -- the resolver's streamed branch did not run", readCpu(map_is_streamed)))
    return false
  end
  local actualCamNt = readCpu(cam_nt)
  if actualCamNt ~= expected_cam_nt then
    fail(EXIT_WRONG_STREAMED, string.format("cam_nt is %d, expected %d -- the landing scroll's own nametable-select bits", actualCamNt, expected_cam_nt))
    return false
  end
  local actualCamXLo = readCpu(cam_x_lo)
  if actualCamXLo ~= expected_cam_x_lo then
    fail(EXIT_WRONG_STREAMED, string.format("cam_x_lo is %d, expected %d -- the landing's own published horizontal scroll", actualCamXLo, expected_cam_x_lo))
    return false
  end
  local actualCamYLo = readCpu(cam_y_lo)
  if actualCamYLo ~= expected_cam_y_lo then
    fail(EXIT_WRONG_STREAMED, string.format("cam_y_lo is %d, expected %d -- the landing's own published vertical scroll", actualCamYLo, expected_cam_y_lo))
    return false
  end

  for _, check in ipairs(block_checks) do
    local tl = readPpu(check.tlAddr)
    local tr = readPpu(check.trAddr)
    local bl = readPpu(check.blAddr)
    local br = readPpu(check.brAddr)

    if tl ~= check.tl or tr ~= check.tr or bl ~= check.bl or br ~= check.br then
      fail(EXIT_WRONG_RENDER, string.format(
        "%s: is [%d,%d,%d,%d], expected [%d,%d,%d,%d] -- sw_render_window drew the wrong tile ids",
        check.label, tl, tr, bl, br, check.tl, check.tr, check.bl, check.br))
      return false
    end
  end

  for _, check in ipairs(attr_checks) do
    local actual = readPpu(check.addr)
    if actual ~= check.expected then
      fail(EXIT_WRONG_RENDER, string.format(
        "%s: attribute byte is %d (%s), expected %d (%s)",
        check.label, actual, decodeQuadrants(actual), check.expected, decodeQuadrants(check.expected)))
      return false
    end
  end

  pass(string.format(
    "window-render parity at the real first display-enable frame: cam_nt=%d, cam_x_lo=%d, cam_y_lo=%d, all %d blocks and %d attribute bytes match the independent project.json oracle",
    actualCamNt, actualCamXLo, actualCamYLo, #block_checks, #attr_checks))
  return true
end

-- The real display-enable boundary: the FIRST $2001 write with bits $18 (background+sprites) newly
-- set, while map_is_streamed is already 1 -- fires synchronously at that exact write, before any
-- later frame's own main-loop/NMI code (including ordinary per-frame camera tracking) can run.
local function onMaskWrite(address, value)
  local wasOn = (previousMask & 0x18) ~= 0
  local isOn = (value & 0x18) ~= 0
  previousMask = value
  if checked then return end
  if not isOn or wasOn then return end
  if readCpu(map_is_streamed) ~= 1 then return end
  checked = true
  if checkRender() then emu.stop(0) end
end

local function onFrame()
  frame = frame + 1

  if frame == 30 then
    baselineFrameCnt = readCpu(frame_cnt)
  end

  if frame < 60 then return end

  if frame == 60 and baselineFrameCnt == 0 and readCpu(frame_cnt) == 0 then
    fail(EXIT_NO_BOOT, "frame_cnt is still 0 after 60 frames -- the NMI is not running")
    return
  end

  if checked then return end

  if frame > 180 then
    local current = readCpu(frame_cnt)
    local state = readCpu(game_state)
    if current == baselineFrameCnt then
      fail(EXIT_NO_BOOT, string.format(
        "frame_cnt held at %d from frame 30 through frame %d -- the NMI stopped, or never really ran",
        baselineFrameCnt, frame))
    elseif state ~= ST_GAMEPLAY then
      fail(EXIT_BAD_STATE, string.format(
        "game_state is %d, not ST_GAMEPLAY (%d), %d frames after boot", state, ST_GAMEPLAY, frame))
    else
      fail(EXIT_NO_RENDER_ENABLE, string.format(
        "no $2001 write enabled rendering while map_is_streamed was 1 within %d frames", frame))
    end
  end
end

emu.addEventCallback(onFrame, emu.eventType.endFrame)
emu.addMemoryCallback(onMaskWrite, emu.callbackType.write, 0x2001)
