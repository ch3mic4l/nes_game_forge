-- sw_render_check.lua.template -- phase 2 slice 2b, Part I: real window-render parity.
--
-- TEMPLATE, not run directly -- test/lua/build_sw_render_roms.mjs instantiates it, substituting
-- __PLACEHOLDER__ tokens resolved fresh out of that exact build's own constants.asm/config.inc
-- (frame_cnt/game_state/ST_GAMEPLAY/map_is_streamed/cam_nt) plus an INDEPENDENT oracle computed
-- straight from the project JSON that built the ROM (expected tile ids, expected palette bytes,
-- the nametable/attribute PPU addresses to read) -- never by reading back what the ROM itself
-- wrote. See build_sw_render_roms.mjs's own header for why the oracle needs no re-implementation
-- of sw_render_window's own ring/torus instruction-level arithmetic: a landing always sets
-- win_col_local/win_row_local to 0, so each physical nametable maps onto exactly ONE authored
-- screen (or fill) for its entire block grid, verified independently there.
--
-- The project boots straight onto a NON-TRIVIAL-parity streamed screen (col=1,row=1 -- both odd)
-- via startMap/startScreen, so this exercises cam_nt's real parity computation (case 20's own
-- finding), not the (0,0) trivial case every other check in this codebase already covers.
--
-- Fix round 2, R4: block_checks now covers EVERY metatile block (16x15) of all four physical
-- nametables (not only block(0,0)), and attr_checks covers EVERY attribute byte (8x8) of all
-- four (not only cell(0,0)'s TL quadrant) -- including the one non-corner block (MID) the second
-- --break mode corrupts in isolation, and the one genuine attribute-boundary limitation of this
-- design (the last attribute row's bottom-half quadrants are unconditionally zero, since a
-- nametable's own 15 block-rows have no even pairing and attribute bytes never span nametables).
--
--   node test/lua/build_sw_render_roms.mjs [outDir] [--break=blank-landing-tile|mid-block-attr]
--   Mesen --testRunner <outDir>/sw_render_check.lua <outDir>/sw_render.nes
--
-- Boot-sanity gate (frame_cnt advances, game_state settles on ST_GAMEPLAY) reuses
-- sw_quadrant_check.lua.template's own two-sample technique verbatim -- "did the mechanism run"
-- before correctness. Then: map_is_streamed must be 1 (the resolver's streamed branch actually
-- ran) and cam_nt must match the independently-computed parity value, both RAM reads: real, but
-- upstream of the render itself. The render check then reads every block's own four tiles
-- (mt_tl/tr/bl/br) and every attribute byte directly out of PPU memory, comparing each against
-- the oracle's expected values.

local frame_cnt        = __FRAME_CNT__
local game_state       = __GAME_STATE__
local ST_GAMEPLAY      = __ST_GAMEPLAY__
local map_is_streamed  = __MAP_IS_STREAMED__
local cam_nt            = __CAM_NT__
local expected_cam_nt   = __EXPECTED_CAM_NT__

local block_checks = __BLOCK_CHECKS__
local attr_checks = __ATTR_CHECKS__

local EXIT_TIMEOUT        = 99
local EXIT_NO_BOOT        = 2
local EXIT_BAD_STATE      = 3
local EXIT_WRONG_STREAMED = 4
local EXIT_WRONG_RENDER   = 5

local frame = 0
local baselineFrameCnt = nil
local checked = false

local function log(message) emu.log(message) end
local function fail(code, message) log("FAIL: " .. message) emu.stop(code) end
local function pass(message) log("ok   " .. message) end
local function readCpu(address) return emu.read(address, emu.memType.nesMemory) end
local function readPpu(address) return emu.read(address, emu.memType.nesPpuMemory) end

local function decodeQuadrants(byte)
  return string.format("tl=%d tr=%d bl=%d br=%d", byte & 0x3, (byte >> 2) & 0x3, (byte >> 4) & 0x3, (byte >> 6) & 0x3)
end

local function checkRender()
  if readCpu(map_is_streamed) ~= 1 then
    fail(EXIT_WRONG_STREAMED, string.format("map_is_streamed is %d, not 1 -- the resolver's streamed branch did not run", readCpu(map_is_streamed)))
    return false
  end
  local actualCamNt = readCpu(cam_nt)
  if actualCamNt ~= expected_cam_nt then
    fail(EXIT_WRONG_STREAMED, string.format("cam_nt is %d, expected %d (screenCol=1,screenRow=1 parity) -- the landing scroll's own nametable-select bits", actualCamNt, expected_cam_nt))
    return false
  end

  for _, check in ipairs(block_checks) do
    local tl = readPpu(check.tlAddr)
    local tr = readPpu(check.trAddr)
    local bl = readPpu(check.blAddr)
    local br = readPpu(check.brAddr)

    if tl ~= check.tl or tr ~= check.tr or bl ~= check.bl or br ~= check.br then
      fail(EXIT_WRONG_RENDER, string.format(
        "%s: is [%d,%d,%d,%d], expected [%d,%d,%d,%d] -- sw_render_window drew the wrong tile ids",
        check.label, tl, tr, bl, br, check.tl, check.tr, check.bl, check.br))
      return false
    end
  end

  for _, check in ipairs(attr_checks) do
    local actual = readPpu(check.addr)
    if actual ~= check.expected then
      fail(EXIT_WRONG_RENDER, string.format(
        "%s: attribute byte is %d (%s), expected %d (%s)",
        check.label, actual, decodeQuadrants(actual), check.expected, decodeQuadrants(check.expected)))
      return false
    end
  end

  pass(string.format("window-render parity: cam_nt=%d, all %d blocks and %d attribute bytes match the independent project.json oracle", actualCamNt, #block_checks, #attr_checks))
  return true
end

local function onFrame()
  frame = frame + 1

  if frame == 30 then
    baselineFrameCnt = readCpu(frame_cnt)
  end

  if frame < 60 then return end

  if frame == 60 and baselineFrameCnt == 0 and readCpu(frame_cnt) == 0 then
    fail(EXIT_NO_BOOT, "frame_cnt is still 0 after 60 frames -- the NMI is not running")
    return
  end

  local current = readCpu(frame_cnt)
  local state = readCpu(game_state)
  if current ~= baselineFrameCnt and state == ST_GAMEPLAY then
    if checkRender() then emu.stop(0) end
    checked = true
    return
  end

  if frame > 180 then
    if checked then return end
    if current == baselineFrameCnt then
      fail(EXIT_NO_BOOT, string.format(
        "frame_cnt held at %d from frame 30 through frame %d -- the NMI stopped, or never really ran",
        baselineFrameCnt, frame))
    else
      fail(EXIT_BAD_STATE, string.format(
        "game_state is %d, not ST_GAMEPLAY (%d), %d frames after boot", state, ST_GAMEPLAY, frame))
    end
  end
end

emu.addEventCallback(onFrame, emu.eventType.endFrame)
