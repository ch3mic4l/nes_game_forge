-- bound_tile_nmi_timing.lua.template -- Mesen (cycle-accurate) proof that the
-- worst-case THREE-producer NMI still finishes inside vblank on real
-- hardware timing, not merely produces eventually-correct pixels the way
-- jsnes would regardless of how slow the drain actually is.
--
-- design-tile.md §12 test 14. Bound tiles add flip_tick (engine/entities.asm)
-- as a third producer that ticks unconditionally from main_loop, exactly the
-- way flash_tick already does -- CLAUDE.md's own vram_buf producer-budget
-- passage: Flash made the bound two, not one; a live bound tile makes it
-- three, not two, and main_loop calls flip_tick before flash_tick, so a
-- flip's own packets are always queued first. This test forces all three to
-- share the box's own raise sequence (the worst-case frame flash_nmi_timing
-- already proves for two producers), by directly re-queuing an already-
-- cached, already-real flip at the exact instruction boundary flip_tick's
-- own drain reads it -- the identical "poke the engine's own RAM at the
-- precise instant" technique flash_nmi_timing.lua.template already uses for
-- Flash's own edge, not a synthetic scenario the real engine could not reach
-- on its own: the switch this re-queues was genuinely set by a real
-- setSwitch a few frames earlier (so bind_idx/bind_mt already hold the real,
-- correct cache entry flip_emit's own bound_tile_lookup will read), and the
-- FIFO/dedupe/budget machinery around the re-queued entry is the same real
-- code a second, later toggle would drive.
--
-- This is a TEMPLATE, not the script Mesen runs directly.
-- test/lua/build_bound_tile_nmi_roms.mjs instantiates it into the same
-- output directory as the ROM it built, substituting the five
-- __PLACEHOLDER__ tokens below with addresses resolved fresh out of that
-- exact build's own game.fns (nmi_rti, main_loop_ready, flash_tick,
-- flip_tick) or measured against the booted ROM (flash_left -- see
-- build_bound_tile_nmi_roms.mjs's own header comment). Never edit the
-- substituted addresses directly in the generated file -- edit this
-- template and re-run the build script.
--
--   node test/lua/build_bound_tile_nmi_roms.mjs [outDir]
--   Mesen --testRunner <outDir>/bound_tile_nmi_timing.lua <outDir>/bound_tile_nmi.nes
--
-- (test/lua/run_bound_tile_nmi_check.sh does both steps.)
local NMI_RTI          = __NMI_RTI__          -- zero-byte label on nmi's own rti (engine/boot.asm)
local MAIN_LOOP_READY  = __MAIN_LOOP_READY__  -- engine/boot.asm's own end-of-main_loop label
local FLASH_TICK       = __FLASH_TICK__       -- engine/entities.asm's own flash_tick
local FLIP_TICK        = __FLIP_TICK__        -- engine/entities.asm's own flip_tick
local FLASH_LEFT       = __FLASH_LEFT__       -- see build_bound_tile_nmi_roms.mjs's own header

-- Engine RAM, from engine/constants.asm. flip_pending_idx/flip_pending_count
-- are plain `NAME = $hex` equates (unlike flash_left), so their addresses
-- are stable literals hardcoded here the same way GAME_STATE/BOX_STATE
-- already are in every other Lua check in this directory.
local GAME_STATE          = 0x25
local VRAM_LEN            = 0x3c
local VRAM_BUF            = 0x0400
local SWITCHES            = 0x0390
local FLIP_PENDING_IDX    = 0x055f
local FLIP_PENDING_COUNT  = 0x0567

local ST_TITLE  = 3
local ST_DIALOG = 2
local FLASH_ARM_VALUE = 7 -- engine/constants.asm's FLASH_TOTAL_FRAMES (6) + 1
local BOUND_SWITCH = 5    -- build_bound_tile_nmi_roms.mjs's own fixture: setSwitch 5, bound at (row 0, col 0)
local BOUND_CELL   = 0    -- row 0 * 16 + col 0

-- Three producers' packets, all still undrained the instant main_loop_ready
-- is reached: flip_tick's own two small packets (2-byte body each, one for
-- the bound cell's top tile row and one for its bottom), Flash's own on-edge
-- packet (32-byte body) and the box's own raise row (32-byte body) --
-- design-tile.md §12 test 14's own "vram_len==80" bound: 5 + 5 + 35 + 35 = 80.
-- vram_buf[80] is vram_end's own terminator at the next byte. Anchoring on
-- this exact shape, not merely "some traffic happened", is what makes the
-- deadline check below actually mean "the worst case was exercised".
local EXPECTED_VRAM_LEN = 80

-- Each packet's own header is [addr_hi, addr_lo, count, ...body...]. Ordering
-- follows main_loop's own call order (flip_tick, then flash_tick, then
-- dispatch_input/ui_tick's own text_tick), which is deterministic, not
-- incidental (CLAUDE.md's own vram_buf ordering passage).
local FLIP_PACKET_HEADER_HI    = 0x20 -- the bound cell's own nametable page (row 0)
local FLIP_PACKET_BODY_COUNT   = 2
local FLASH_PACKET_HEADER_HI   = 0x3F
local FLASH_PACKET_BODY_COUNT  = 32
local TEXT_ROW_HEADER_HI_MIN   = 0x20
local TEXT_ROW_HEADER_HI_MAX   = 0x23
local TEXT_ROW_BODY_COUNT      = 32

-- NTSC NES vblank: scanlines 241-260 inclusive, 341 dots (0-340) per
-- scanline. rti's own remaining execution (6 CPU cycles = 18 PPU dots,
-- NTSC's 3-dots-per-cycle) is added to the sampled dot before checking it is
-- still inside a scanline -- flash_nmi_timing.lua.template's own reasoning,
-- unchanged here.
local VBLANK_FIRST_SCANLINE = 241
local VBLANK_LAST_SCANLINE  = 260
local DOTS_PER_SCANLINE     = 341
local PPU_DOTS_PER_CPU_CYCLE = 3
local RTI_REMAINING_CYCLES  = 6
local RTI_REMAINING_DOTS    = RTI_REMAINING_CYCLES * PPU_DOTS_PER_CPU_CYCLE

local EXIT_TIMEOUT         = 99
local EXIT_NO_BOOT         = 2
local EXIT_NEVER_DIALOG    = 3
local EXIT_NEVER_ARMED     = 4
local EXIT_DEADLINE_MISS   = 5
local EXIT_STALE_ANCHOR    = 6
local EXIT_WORKLOAD_SHORT  = 7

local frame = 0
local phase = 1
local held = {}
local mark = 0
local dialogOpen = false
local armed = false
local checkedDeadline = false
local checkedAnchor = false
local checkedWorkload = false

local function log(message)
  emu.log(string.format("[%5d] %s", frame, message))
end

local function fail(code, message)
  log("FAIL: " .. message)
  emu.stop(code)
end

local function pass(message)
  log("ok   " .. message)
end

local function read(address)
  return emu.read(address, emu.memType.nesMemory)
end

local function write(address, value)
  emu.write(address, value, emu.memType.nesMemory)
end

local function onInput()
  emu.setInput(held, 0)
end

-- Fires on every real flip_tick call. Once the box is genuinely mid-raise
-- and this frame has not yet been armed, this both arms Flash (identical
-- technique to flash_nmi_timing.lua.template's own onFlashTick, hooked one
-- instruction boundary earlier here since flip_tick runs before flash_tick
-- in main_loop) and re-queues the bound cell into the pending FIFO, so THIS
-- exact flip_tick call drains a real packet for it -- the switch was already
-- set for real several frames earlier (the fixture's own setSwitch, ahead of
-- its Say), so bind_idx/bind_mt already hold the genuine cached entry
-- flip_emit's own bound_tile_lookup will read; only the timing of *when* it
-- drains is being forced, not its content.
local function onFlipTick()
  if not dialogOpen or armed then return end
  armed = true
  write(FLIP_PENDING_IDX, BOUND_CELL)
  write(FLIP_PENDING_COUNT, 1)
  write(FLASH_LEFT, FLASH_ARM_VALUE)
  pass("re-queued the bound cell and armed Flash the instruction before flip_tick's own drain -- watching for this frame's main_loop_ready then the next nmi_rti")
end

-- Fires the first time the CPU executes main_loop_ready after this frame was
-- armed -- one frame before the NMI this check's own deadline assertion
-- cares about, and the only point in the whole frame where all three
-- producers' packets are queued but not yet drained.
local function onMainLoopReady()
  if not armed or checkedWorkload then return end
  checkedWorkload = true
  local vramLen = read(VRAM_LEN)
  local terminator = read(VRAM_BUF + EXPECTED_VRAM_LEN)
  if vramLen ~= EXPECTED_VRAM_LEN then
    fail(EXIT_WORKLOAD_SHORT, string.format(
      "main_loop_ready: vram_len is %d, not %d -- the three-producer workload (flip, Flash, the box's own row) did not all queue this frame",
      vramLen, EXPECTED_VRAM_LEN))
    return
  end
  if terminator ~= 0 then
    fail(EXIT_WORKLOAD_SHORT, string.format(
      "main_loop_ready: vram_buf[%d] is %d, not the terminator (0) -- the queue shape does not match three full packets",
      EXPECTED_VRAM_LEN, terminator))
    return
  end

  -- Packet 0: flip's own top-row packet (offset 0, 5 bytes: 3 header + 2 body).
  local pkt0Hi, pkt0Count = read(VRAM_BUF + 0), read(VRAM_BUF + 2)
  -- Packet 1: flip's own bottom-row packet (offset 5, 5 bytes).
  local pkt1Hi, pkt1Count = read(VRAM_BUF + 5), read(VRAM_BUF + 7)
  -- Packet 2: Flash's own on-edge packet (offset 10, 35 bytes: 3 header + 32 body).
  local pkt2Hi, pkt2Count = read(VRAM_BUF + 10), read(VRAM_BUF + 12)
  -- Packet 3: the box's own raise row (offset 45, 35 bytes).
  local pkt3Hi, pkt3Count = read(VRAM_BUF + 45), read(VRAM_BUF + 47)

  if pkt0Hi ~= FLIP_PACKET_HEADER_HI or pkt0Count ~= FLIP_PACKET_BODY_COUNT then
    fail(EXIT_WORKLOAD_SHORT, string.format(
      "main_loop_ready: packet 0 (flip's own top row, queued first -- main_loop calls flip_tick before flash_tick) is [$%02x, count %d], expected [$%02x, count %d]",
      pkt0Hi, pkt0Count, FLIP_PACKET_HEADER_HI, FLIP_PACKET_BODY_COUNT))
    return
  end
  if pkt1Hi ~= FLIP_PACKET_HEADER_HI or pkt1Count ~= FLIP_PACKET_BODY_COUNT then
    fail(EXIT_WORKLOAD_SHORT, string.format(
      "main_loop_ready: packet 1 (flip's own bottom row) is [$%02x, count %d], expected [$%02x, count %d]",
      pkt1Hi, pkt1Count, FLIP_PACKET_HEADER_HI, FLIP_PACKET_BODY_COUNT))
    return
  end
  if pkt2Hi ~= FLASH_PACKET_HEADER_HI or pkt2Count ~= FLASH_PACKET_BODY_COUNT then
    fail(EXIT_WORKLOAD_SHORT, string.format(
      "main_loop_ready: packet 2 (Flash's own edge, queued after both flip packets, ahead of settle_owed/dispatch_input/ui_tick) is [$%02x, count %d], expected [$%02x, count %d]",
      pkt2Hi, pkt2Count, FLASH_PACKET_HEADER_HI, FLASH_PACKET_BODY_COUNT))
    return
  end
  if pkt3Hi < TEXT_ROW_HEADER_HI_MIN or pkt3Hi > TEXT_ROW_HEADER_HI_MAX or pkt3Count ~= TEXT_ROW_BODY_COUNT then
    fail(EXIT_WORKLOAD_SHORT, string.format(
      "main_loop_ready: packet 3 (the box's own raise row, queued last from ui_tick's own text_tick) is [$%02x, count %d], expected hi in $%02x-$%02x, count %d",
      pkt3Hi, pkt3Count, TEXT_ROW_HEADER_HI_MIN, TEXT_ROW_HEADER_HI_MAX, TEXT_ROW_BODY_COUNT))
    return
  end
  pass(string.format(
    "main_loop_ready workload confirmed: vram_len=%d, four packets in order (flip top [$%02x,%d], flip bottom [$%02x,%d], Flash [$%02x,%d], box row [$%02x,%d])",
    vramLen, pkt0Hi, pkt0Count, pkt1Hi, pkt1Count, pkt2Hi, pkt2Count, pkt3Hi, pkt3Count))
end

-- Fires every time the CPU executes nmi's own rti. Only meaningful once
-- this frame has genuinely been armed.
local function onNmiRti()
  if not armed or checkedDeadline then return end
  if not checkedWorkload then
    checkedDeadline = true
    fail(EXIT_WORKLOAD_SHORT, "nmi_rti reached before this frame's own main_loop_ready workload check -- the callback order was reversed")
    return
  end
  checkedDeadline = true
  local state = emu.getState()
  local scanline = state["ppu.scanline"]
  local cycle = state["ppu.cycle"]
  local vramLen = read(VRAM_LEN)
  log(string.format(
    "nmi_rti reached: scanline=%d cycle=%d (+%d rti dots remaining) vram_len=%d",
    scanline, cycle, RTI_REMAINING_DOTS, vramLen
  ))
  if vramLen ~= 0 then
    fail(EXIT_DEADLINE_MISS, string.format("vram_len should be 0 right after the drain, saw %d", vramLen))
    return
  end
  if scanline < VBLANK_FIRST_SCANLINE or scanline > VBLANK_LAST_SCANLINE then
    fail(EXIT_DEADLINE_MISS, string.format("nmi_rti landed on scanline %d, outside vblank (%d-%d)", scanline, VBLANK_FIRST_SCANLINE, VBLANK_LAST_SCANLINE))
    return
  end
  local finishDot = cycle + RTI_REMAINING_DOTS
  local finishScanline = scanline
  while finishDot >= DOTS_PER_SCANLINE do
    finishDot = finishDot - DOTS_PER_SCANLINE
    finishScanline = finishScanline + 1
  end
  if finishScanline > VBLANK_LAST_SCANLINE then
    fail(EXIT_DEADLINE_MISS, string.format("rti's own remaining %d dots push past vblank (from scanline %d, cycle %d, landing on scanline %d)", RTI_REMAINING_DOTS, scanline, cycle, finishScanline))
    return
  end
  pass(string.format("the three-producer NMI finished at scanline %d, cycle %d (rti settles on scanline %d) -- inside vblank (%d-%d) with room to spare", scanline, cycle, finishScanline, VBLANK_FIRST_SCANLINE, VBLANK_LAST_SCANLINE))
  log("all phases passed")
  emu.stop(0)
end

local function onFrame()
  frame = frame + 1
  if not checkedAnchor then
    checkedAnchor = true
    local nmiByte = read(NMI_RTI)
    if nmiByte ~= 0x40 then
      fail(EXIT_STALE_ANCHOR, string.format(
        "byte at NMI_RTI (0x%04x) is 0x%02x, not rti ($40) -- this address is stale; re-run build_bound_tile_nmi_roms.mjs",
        NMI_RTI, nmiByte))
      return
    end
    pass(string.format("NMI_RTI anchor verified: byte at 0x%04x is $40 (rti)", NMI_RTI))
  end
  if frame > 2000 then
    fail(EXIT_TIMEOUT, "timed out in phase " .. phase)
    return
  end

  if phase == 1 then
    if frame < 30 then return end
    if read(GAME_STATE) == ST_TITLE then
      pass("booted to the title -- pressing Start")
      held = { start = true }
      mark = frame
      phase = 1.5
      return
    end
    pass("booted straight into gameplay")
    phase = 2
    held = { b = true }
    mark = frame
    return
  end

  if phase == 1.5 then
    if frame - mark < 6 then return end
    held = {}
    if frame - mark < 20 then return end
    if read(GAME_STATE) == ST_TITLE then
      fail(EXIT_NO_BOOT, "pressed Start but the title never cleared")
      return
    end
    pass("Start cleared the title")
    phase = 2
    held = { b = true }
    mark = frame
    return
  end

  -- 2: press B once -- the actor sits immediately next to the player's own
  -- start position, so one press is enough to open the box. Its own page
  -- runs setSwitch (a real toggle, populating bind_idx/bind_mt for real)
  -- immediately before the Say that opens the box.
  if phase == 2 then
    if frame - mark < 1 then return end
    held = {}
    phase = 3
    mark = frame
    return
  end

  -- 3: confirm the box actually opened and the switch genuinely landed, then
  -- let onFlipTick force the three-way overlap on the very next flip_tick
  -- call during the box's own raise sequence.
  if phase == 3 then
    if frame - mark < 2 then return end
    if read(GAME_STATE) ~= ST_DIALOG then
      fail(EXIT_NEVER_DIALOG, "the message box never opened")
      return
    end
    if (read(SWITCHES) & (1 << BOUND_SWITCH)) == 0 then
      fail(EXIT_NEVER_DIALOG, "the fixture's own setSwitch never landed before the box opened")
      return
    end
    dialogOpen = true
    pass("dialog confirmed open with the switch genuinely set -- forcing the three-way overlap at the next flip_tick call")
    phase = 4
    mark = frame
    return
  end

  if phase == 4 then
    if checkedDeadline then return end
    if frame - mark > 10 then
      if not armed then
        fail(EXIT_NEVER_ARMED, "flip_tick was never reached after the dialog opened")
      else
        fail(EXIT_NEVER_ARMED, "nmi_rti was never reached after arming")
      end
    end
  end
end

emu.addEventCallback(onFrame, emu.eventType.endFrame)
emu.addEventCallback(onInput, emu.eventType.inputPolled)
emu.addMemoryCallback(onFlipTick, emu.callbackType.exec, FLIP_TICK)
emu.addMemoryCallback(onMainLoopReady, emu.callbackType.exec, MAIN_LOOP_READY)
emu.addMemoryCallback(onNmiRti, emu.callbackType.exec, NMI_RTI)
