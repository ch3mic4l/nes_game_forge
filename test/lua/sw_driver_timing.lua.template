local EXIT_NO_COL_CROSSING       = 10 -- the busy phase never saw sw_col change (column/Right axis)
local EXIT_NO_ROW_CROSSING       = 11 -- the busy phase never saw sw_row change (row/Down axis) --
                                       -- expected, deliberately, only under SKIP_DOWN_LEG.
-- Fix round 1 (gates round-1, Task 1): one EXIT code per new workload's own evidence check.
local EXIT_NO_CONTACT_DAMAGE           = 12 -- workload (a): player_iframes never went 0 -> IFRAME_TIME
local EXIT_NO_RELEASE_FALLBACK         = 13 -- workload (c): sw_axis_pref never flipped via the
                                             -- fallback branch (no fresh pad_new press that frame)
local EXIT_NO_UNALIGNED_3SCREEN        = 14 -- workload (d): no column arm's own entering edge ever
                                             -- spanned three distinct screen-rows
local EXIT_NO_VRAM_STRIP_COOCCURRENCE  = 15 -- workload (e): vram_len was never nonzero at a real NMI
                                             -- entry while st_active was also nonzero that frame
local EXIT_NO_ROW8_EIGHT_ACTORS        = 16 -- fix round 2, gates round-2 finding 1 -- workload (b):
                                             -- no fresh ROW arm on the Down-target screen was ever
                                             -- observed with all eight ent_active slots occupied
-- Round-3 gate closure Task 2: ABSOLUTE per-path regression ceilings, separate from encoding
-- capacity (MARGIN_SCALE/MAINLINE_MARGIN_SCALE) and the NTSC frame budget (run_sw_driver_timing_
-- check.sh's own frame-inequality check) -- calibrated from this exact fixture's own clean real
-- measurement plus a stated small tolerance. Round-3 review's own review-s4b-round3-slow-check.sh
-- (a 1,276-cycle busy-loop delay at every real sw_update_player entry, EVERY frame) proved every
-- EXISTING check in this template is RELATIVE only (cheap < expensive; broken-arm average > plain
-- idle average; real-actor mainline > no-actors mainline) -- a UNIFORM per-frame regression shifts
-- both sides of every one of those comparisons together and passes them all. These two ceilings are
-- ABSOLUTE, so a uniform regression that clears the encoding range and every relative check still
-- fails here. Scoped to the ordinary busy-phase metrics only (guarded by `not IDLE_ONLY` below) --
-- never applied to an idle-only build, so the --break=unconditional-arm control's own legitimately
-- higher idle-only average (its whole point) is never at risk of tripping these.
-- Recalibrated (Chris ruling, 2026-09-24, fix round 2): with all five workloads (a)-(e) genuinely
-- live in the ordinary busy walk (gates round-1), the real clean measurement grew past the old
-- 18,000/22,000 ceilings by a modest, real margin -- not a hardware/frame-budget overrun (the frame
-- inequality below still holds with thousands of cycles of margin), but a real heavier scenario on
-- unchanged engine source. Rule: take the LARGER clean upper bucket endpoint across the ordinary and
-- --row8 builds, add 600 cycles of headroom, round UP to the next 100 cycles.
-- Clean measurement (review round 2, this exact 3x61/row-58 fixture, real 8/4 (ordinary) or 8/8
-- (--row8) chasers): expensive-path busy max ordinary 18,000-18,149 cyc, --row8 18,450-18,599 cyc
-- (larger 18,599); mainline-busy max ordinary 23,400-23,599 cyc, --row8 23,400-23,599 cyc (same
-- bucket -- the fix round 1 report's own cited 24,600-24,799 for --row8 came from a reverted debug
-- encode and does not reproduce against the shipped harness; correct figure is 23,400-23,599, per
-- fix round 2's own re-measurement). ceil100(18,599+600)=19,200; ceil100(23,599+600)=24,200.
-- Verified against the in-tree --break=slow-driver control (the reviewer's ldx #255/dex/bne,
-- ~1,276 cyc, at sw_update_player's own entry): expensive-path 19,350-19,499 cyc, mainline-busy
-- 24,600-24,799 cyc under that mutation -- both real numbers clear both recalibrated ceilings with
-- margin left over, not saturated.
local EXIT_EXPENSIVE_REGRESSION  = 8
local EXIT_MAINLINE_REGRESSION   = 9
local EXPENSIVE_CEILING_CYCLES = 19200
local MAINLINE_CEILING_CYCLES  = 24200

-- Pass encoding: exit code = EXIT_PASS_BASE + floor(maxCycles / MARGIN_SCALE), clamped -- the same
-- channel-of-last-resort convention sw_nmi_deadline.lua.template's own header documents in full.
local EXIT_PASS_BASE = 100
-- cycles per exit-code unit. Real measurement against THIS fixture (3x61 grid, landing (1,58), real
-- 8/4-chaser targets) is filled in by run_sw_driver_timing_check.sh's own header once measured --
-- this constant must stay wide enough to encode the real worst case (driver span) AND the real
-- worst mainline span (markedly larger, since it carries update_entities' own AI cost) without
-- saturating either. See run_sw_driver_timing_check.sh's own MARGIN_SCALE/MAINLINE_MARGIN_SCALE
-- comments for the exact figures this was set from.
local MARGIN_SCALE = 150
local MAINLINE_MARGIN_SCALE = 200
-- An idle-only build reports sumIdleCycles/idleFrameCount (average), not a max -- a much smaller
-- magnitude, so it gets its own, finer scale.
local IDLE_AVG_SCALE = 100
-- A single NMI's own worst span is much smaller than a whole mainline frame -- a finer scale so the
-- real figure (whatever this busy walk measures) has room to land inside the encodable range without
-- guessing in advance; run_sw_driver_timing_check.sh's own header records the real measurement once
-- taken, the same convention MARGIN_SCALE/MAINLINE_MARGIN_SCALE already follow.
local NMI_MARGIN_SCALE = 20
local EXIT_PASS_MAX = 255

-- Right leg: ~256 px at ~1.4-1.5 px/frame plus margin for the initial arm-settle. Down leg:
-- ~240 px, same margin logic. Both re-armed back to back (release-handoff, no idle gap) -- ruling
-- M's own "release-handoff-to-another-held-axis" case.
local FRAME_BUSY_LIMIT_RIGHT = 260
local FRAME_BUSY_LIMIT_DOWN  = 240
local FRAME_IDLE_LIMIT = 120
-- Fix round 1 (gates round-1, Task 1) workload (d): win_row_local was empirically confirmed (via a
-- real Mesen debug probe) to stay at 0 through 80+ real frames of holding Down within a single
-- screen -- it only moves once the player genuinely CROSSES a screen row (sw_row itself changes),
-- which happens ~85 frames after a startY=120 landing. Rather than let that crossing land the
-- player on LANDING_ROW at an unpredictable Y (disturbing leg 1/leg 2's own established geometry),
-- build_sw_driver_timing_roms.mjs starts the ordinary (non---align-landing-y) build one row further
-- north (PRE_LANDING_ROW) and this phase holds Down just long enough to cross back onto LANDING_ROW
-- -- the exact screen leg 1 already expects -- before any busy phase begins. 95 frames gives a ~10-
-- frame buffer past the ~85-frame crossing point (confirmed via the same probe: sw_row reads
-- LANDING_ROW, not PRE_LANDING_ROW, at 90 and 95 frames) while staying well clear of a SECOND
-- crossing onto DOWN_TARGET_ROW (~85 more frames away) and without meaningfully disturbing the
-- busy-phase timing this fixture otherwise measures (not counted toward any cycle metric).
local PRE_DOWN_FRAMES = 95
local TIMEOUT_FRAMES = 2200

local frame = 0
-- Fix round 1 (gates round-1, Task 1) workload (d): boot always sets win_row_local to 0 -- "the
-- window is aligned to the entered screen's own top-left corner" (engine/streamworld.asm:2628-2636)
-- -- regardless of startY, so the column arm's own vertical entering edge is trivially aligned
-- unless the row window has already taken at least one real step (sw_win_row_inc/dec, only reached
-- via a genuine row arm) before that column arm fires. "pre_down" is a short phase, BEFORE the
-- measured busy phases begin, holding Down alone just long enough for the camera-follow window to
-- drift within the landing screen and take that first step -- not counted toward any cycle metric
-- (every onXxxEntry callback below is gated to busy_right/busy_down/idle, which this phase name
-- deliberately does not match).
local phase = "boot"  -- boot -> pre_down -> [busy_right -> busy_down ->] idle -> done (IDLE_ONLY skips pre_down and both legs)
local phaseStartFrame = 0
local held = {}

local swColBefore, swRowBefore, stActiveBefore, entActiveSumBefore = nil, nil, nil, nil
local spanStart = nil
local spanStart2 = nil

local sawCrossing = false
local sawFreshArm = false
local sawColCrossing = false
local sawRowCrossing = false
-- Fix round 1 (gates round-1, Task 1) workload evidence flags.
local sawContactDamage = false
local sawReleaseFallback = false
local sawUnaligned3Screen = false
local sawVramStripCoOccurrence = false
-- Fix round 2 (gates round-2 finding 1) workload (b)'s own evidence flag.
local sawRow8EightActors = false
local padBefore, padNewBefore, axisPrefBefore, iframesBeforeThisFrame = nil, nil, nil, nil
local maxBusyCycles = 0
local maxIdleCycles = 0
local maxCheapCycles = 0
local maxExpensiveCycles = 0
-- A per-frame uniform-overhead defect (unconditionally doing real work a gate should have
-- skipped) can be CHEAPER, frame for frame, than a legitimate rare peak (e.g. a real one-time
-- post-landing convergence) -- found empirically comparing --break=unconditional-arm's own
-- idle-only MAX (7.8-8.0k cyc) against the unbroken idle-only MAX (13.0-13.2k cyc): the mutated
-- build's own max was LOWER, even though it pays real extra cost on every single idle frame the
-- unbroken build mostly does not. A max-of-run metric is blind to that shape. sumIdleCycles/
-- idleFrameCount (AVERAGE, reported instead of the max for an idle-only build) is what the
-- extra-cost control actually needs, and is only ever used for that build shape.
local sumIdleCycles = 0
local idleFrameCount = 0
local maxMainlineBusyCycles = 0
local maxMainlineIdleCycles = 0

local nmiSpanStart = nil
local nmiVramLenAtEntry = nil
local maxNmiCycles = 0
local maxNmiVramLen = 0
local maxObservedVramLen = 0
-- Real (vram_len, worst cycles observed at that len) samples across the whole busy+idle run --
-- printed in finish() as a real measured table (R4: no longer fit to an extrapolation).
local nmiMaxByLen = {}

local function log(message)
  emu.log(string.format("[%5d/%s] %s", frame, phase, message))
end

local function fail(code, message)
  log("FAIL: " .. message)
  emu.stop(code)
end

local function pass(message)
  log("ok   " .. message)
end

local function read(address)
  return emu.read(address, emu.memType.nesMemory)
end

-- Fix round 1 (gates round-1, Task 1): a single-bit test that needs no bitwise-AND operator (this
-- Lua environment has none built in) -- valid for any power-of-two `bitValue` (BTN_UP/DOWN/LEFT/
-- RIGHT all are).
local function hasBit(value, bitValue)
  return math.floor(value / bitValue) % 2 == 1
end

local function entActiveSum()
  local sum = 0
  for i = 0, MAX_ENTITIES - 1 do
    if read(ENT_ACTIVE + i) ~= 0 then sum = sum + 1 end
  end
  return sum
end

local function clockPosition()
  local state = emu.getState()
  return state["masterClock"]
end

local function onInput()
  emu.setInput(held, 0)
end

local function onMainLoopBodyStartEntry()
  if phase ~= "busy_right" and phase ~= "busy_down" and phase ~= "idle" then return end
  spanStart2 = clockPosition()
end

local function onUpdatePlayerEntry()
  if phase ~= "busy_right" and phase ~= "busy_down" and phase ~= "idle" then return end
  swColBefore = read(SW_COL)
  swRowBefore = read(SW_ROW)
  stActiveBefore = read(ST_ACTIVE)
  entActiveSumBefore = entActiveSum()
  -- Fix round 1 (gates round-1, Task 1) workloads (a)/(c): sampled before update_player runs (and,
  -- for player_iframes, before update_entities too -- see onMainLoopReadyMeasure below, since
  -- entity_contact only runs there).
  padBefore = read(PAD)
  padNewBefore = read(PAD_NEW)
  axisPrefBefore = read(SW_AXIS_PREF)
  iframesBeforeThisFrame = read(PLAYER_IFRAMES)
  spanStart = clockPosition()
end

local function onMainLoopAfterPlayerEntry()
  if spanStart == nil then return end -- update_player's own entry callback has not fired yet
  local spanEnd = clockPosition()
  local cycles = (spanEnd - spanStart) / CPU_CYCLES_PER_MASTER_CLOCK_UNIT
  spanStart = nil

  local swColAfter = read(SW_COL)
  local swRowAfter = read(SW_ROW)
  local stActiveAfter = read(ST_ACTIVE)
  local crossed = (swColAfter ~= swColBefore) or (swRowAfter ~= swRowBefore)
  local freshArm = stActiveBefore == 0 and stActiveAfter ~= 0

  -- Fix round 2 (gates round-2 finding 1) workload (b): a fresh ROW-axis arm (stActiveAfter==2,
  -- distinct from the column arm's own stActiveAfter==1 workload (d) checks below) on the
  -- Down-target screen specifically (sw_col/sw_row == the builder's own DOWN_TARGET_COL/ROW, not
  -- merely "some screen"), with all eight ent_active slots occupied. Gated on the real Down-target
  -- identity so an eight-slot observation on the Right target (which the ordinary, non---row8 build
  -- already has) cannot satisfy this.
  if (phase == "busy_right" or phase == "busy_down") and EXPECT_ROW8 and not sawRow8EightActors
      and freshArm and stActiveAfter == 2
      and swColAfter == DOWN_TARGET_COL and swRowAfter == DOWN_TARGET_ROW
      and entActiveSum() == 8 then
    sawRow8EightActors = true
    log("row8 evidence: fresh ROW arm on Down-target screen with all 8 ent_active slots occupied")
  end

  -- Fix round 1 (gates round-1, Task 1) workload (c): the release-fallback branch (engine/
  -- streamworld.asm:3317-3319) is the ONLY path that can flip sw_axis_pref 0->1 on a frame where
  -- pad_new shows no fresh press on EITHER axis, and pad itself already shows only the row axis
  -- held -- distinct from the ordinary fresh-press path (sw_up_axis_newy, :3301-3303), which
  -- requires a pad_new UP/DOWN bit.
  if (phase == "busy_right" or phase == "busy_down") and not sawReleaseFallback then
    local axisPrefAfter = read(SW_AXIS_PREF)
    local noFreshPress = not hasBit(padNewBefore, BTN_LEFT) and not hasBit(padNewBefore, BTN_RIGHT)
      and not hasBit(padNewBefore, BTN_UP) and not hasBit(padNewBefore, BTN_DOWN)
    local rowOnlyHeld = not hasBit(padBefore, BTN_LEFT) and not hasBit(padBefore, BTN_RIGHT)
      and hasBit(padBefore, BTN_DOWN)
    if axisPrefBefore == 0 and axisPrefAfter == 1 and noFreshPress and rowOnlyHeld then
      sawReleaseFallback = true
      log("release-fallback evidence: sw_axis_pref 0->1, pad_new=0, pad shows Down only")
    end
  end

  -- Fix round 1 (gates round-1, Task 1) workload (d): on the frame a COLUMN strip freshly arms
  -- (stActiveAfter==1, from 0), the entering edge spans winBlocksY=30 blocks starting at
  -- win_row_screen*15+win_row_local. win_row_local is hardcoded to 0 at landing regardless of
  -- startY (engine/streamworld.asm:2628-2636), and sw_frame_camera_window's own desired-window
  -- formula trails that by a 7-block margin -- so only the pre_down phase's own real Down hold
  -- (PRE_DOWN_FRAMES, above) genuinely misaligns win_row_local before this, the first column arm
  -- (the Right crossing), fires. --align-landing-y skips pre_down entirely, the negative control
  -- that leaves win_row_local at 0 and this span at exactly two screens instead of three.
  if (phase == "busy_right" or phase == "busy_down") and stActiveBefore == 0 and stActiveAfter == 1 then
    local winRowScreen = read(WIN_ROW_SCREEN)
    local winRowLocal = read(WIN_ROW_LOCAL)
    local rowBlock = winRowScreen * 15 + winRowLocal
    local spanStartScreen = math.floor(rowBlock / 15)
    local spanEndScreen = math.floor((rowBlock + 29) / 15)
    -- Round-3 gate closure Task 1 (gates round-3 finding 1): read the ACTUAL entering column
    -- (sw_ss_sc, sw_stream_start_col's own saved operand) rather than the window's own near-edge
    -- win_col_screen -- the fill/read branch tests sw_ss_sc against the grid width, and a positive-
    -- column arm's entering edge sits 31 blocks past win_col_screen, so a valid near column does
    -- not establish that the entering column is valid. All three entering screen-rows must also
    -- stay in bounds -- an off-map fill (a fixture bug, or a future geometry that walked past the
    -- grid edge) cannot satisfy this workload just by spanning three screen-row indices.
    local enteringColScreen = read(SW_SS_SC)
    local inBounds = enteringColScreen < GRID_W and spanStartScreen >= 0 and spanEndScreen < GRID_H
    log(string.format("column arm entering-edge span: rowBlock=%d entering_col_screen=%d win_row_screen=%d win_row_local=%d screens [%d,%d] inBounds=%s",
      rowBlock, enteringColScreen, winRowScreen, winRowLocal, spanStartScreen, spanEndScreen, tostring(inBounds)))
    if spanEndScreen - spanStartScreen == 2 and inBounds then
      sawUnaligned3Screen = true
    end
  end

  if crossed and EXPECT_RESPAWN_EVIDENCE then
    local entActiveSumAfter = entActiveSum()
    if entActiveSumAfter == entActiveSumBefore then
      fail(EXIT_NO_RESPAWN_EVIDENCE, string.format(
        "crossing frame (sw_col %d->%d, sw_row %d->%d) but ent_active sum stayed %d -- no real respawn evidence",
        swColBefore, swColAfter, swRowBefore, swRowAfter, entActiveSumBefore))
      return
    end
    log(string.format("respawn evidence ok: ent_active sum %d -> %d on crossing", entActiveSumBefore, entActiveSumAfter))
  end

  if phase == "busy_right" or phase == "busy_down" then
    if crossed then sawCrossing = true end
    if freshArm then sawFreshArm = true end
    if swColAfter ~= swColBefore then sawColCrossing = true end
    if swRowAfter ~= swRowBefore then sawRowCrossing = true end
    if cycles > maxBusyCycles then
      maxBusyCycles = cycles
      log(string.format("new busy max: %.1f cycles (crossed=%s freshArm=%s)", cycles, tostring(crossed), tostring(freshArm)))
    end
    if crossed or freshArm then
      if cycles > maxExpensiveCycles then maxExpensiveCycles = cycles end
    elseif cycles > maxCheapCycles then
      maxCheapCycles = cycles
    end
  elseif phase == "idle" then
    if cycles > maxIdleCycles then
      maxIdleCycles = cycles
      log(string.format("new idle max: %.1f cycles", cycles))
    end
    sumIdleCycles = sumIdleCycles + cycles
    idleFrameCount = idleFrameCount + 1
    if not freshArm and cycles > maxCheapCycles then
      maxCheapCycles = cycles
    end
  end
end

local function onNmiEntry()
  if phase ~= "busy_right" and phase ~= "busy_down" and phase ~= "idle" then return end
  nmiVramLenAtEntry = read(VRAM_LEN)
  -- Fix round 1 (gates round-1, Task 1) workload (e): a real vram_buf producer packet (Shake/Flash/
  -- Sfx, queued by flash_tick) sharing this exact NMI with a still-active strip (st_active ~= 0).
  -- Fix round 2 (gates round-2 finding 2): strengthened to the EXACT preconditions engine/
  -- boot.asm's nmi_vram_dispatch reduced-streaming branch (~490) itself tests -- vram_ready ~= 0
  -- (a half-built/not-ready queue instead takes nmi_no_drain) AND 0 < vram_len <=
  -- MIXED_VBLANK_MAX_BYTES (an oversized queue instead takes nmi_drain_big) -- so a not-ready or
  -- oversized queue can no longer satisfy this flag merely by having vram_len>0 and an active strip.
  if (phase == "busy_right" or phase == "busy_down")
      and read(VRAM_READY) ~= 0
      and nmiVramLenAtEntry > 0 and nmiVramLenAtEntry <= MIXED_VBLANK_MAX_BYTES
      and read(ST_ACTIVE) ~= 0 then
    sawVramStripCoOccurrence = true
  end
  nmiSpanStart = clockPosition()
end

local function onNmiRtiExit()
  if nmiSpanStart == nil then return end
  local spanEnd = clockPosition()
  local cycles = (spanEnd - nmiSpanStart) / CPU_CYCLES_PER_MASTER_CLOCK_UNIT
  nmiSpanStart = nil
  if phase ~= "busy_right" and phase ~= "busy_down" and phase ~= "idle" then return end
  local len = nmiVramLenAtEntry or 0
  if len > maxObservedVramLen then maxObservedVramLen = len end
  local prevAtLen = nmiMaxByLen[len]
  if prevAtLen == nil or cycles > prevAtLen then
    nmiMaxByLen[len] = cycles
  end
  if cycles > maxNmiCycles then
    maxNmiCycles = cycles
    maxNmiVramLen = len
    log(string.format("new nmi max: %.1f cycles (vram_len at entry=%d)", cycles, len))
  end
end

local function onMainLoopReadyMeasure()
  if spanStart2 == nil then return end
  local spanEnd = clockPosition()
  local cycles = (spanEnd - spanStart2) / CPU_CYCLES_PER_MASTER_CLOCK_UNIT
  spanStart2 = nil
  -- Fix round 1 (gates round-1, Task 1) workload (a): entity_contact (engine/combat.asm, called
  -- from engine/entities.asm's own update_entities loop) runs strictly AFTER main_loop_after_player
  -- but before main_loop_ready -- outside the driver span this template otherwise measures -- so
  -- player_iframes' own before/after pair must straddle THIS span, not the driver span above.
  if (phase == "busy_right" or phase == "busy_down") and iframesBeforeThisFrame ~= nil and not sawContactDamage then
    local iframesAfter = read(PLAYER_IFRAMES)
    if iframesBeforeThisFrame == 0 and iframesAfter == IFRAME_TIME then
      sawContactDamage = true
      log(string.format("contact damage evidence: player_iframes 0 -> %d", iframesAfter))
    end
  end
  if phase == "busy_right" or phase == "busy_down" then
    if cycles > maxMainlineBusyCycles then
      maxMainlineBusyCycles = cycles
      log(string.format("new mainline busy max: %.1f cycles", cycles))
    end
  elseif phase == "idle" then
    if cycles > maxMainlineIdleCycles then
      maxMainlineIdleCycles = cycles
    end
  end
end

local function finish()
  -- Round-3 gate closure Task 1: dump every real (vram_len, worst cycles) sample this run saw,
  -- sorted by len, regardless of which REPORT_METRIC was selected -- real measured points, kept for
  -- the report even though R4 (below) removed the extrapolation they used to feed.
  local lens = {}
  for len, _ in pairs(nmiMaxByLen) do lens[#lens + 1] = len end
  table.sort(lens)
  for _, len in ipairs(lens) do
    log(string.format("nmi sample: vram_len=%d -> %.1f cycles", len, nmiMaxByLen[len]))
  end
  pass(string.format("nmi span: busy+idle max %.1f cycles (at vram_len=%d)", maxNmiCycles, maxNmiVramLen))
  -- R4 (fix round 1 orchestrator ruling): the nmi-extrapolated report mode, and the per-byte
  -- extrapolation it was computed from, are REMOVED here -- it projected a single organic run's own
  -- samples to a cited worst-case queue depth instead of measuring a real mixed-queue frame, and the
  -- ruling was explicit that it must not be replaced with another extrapolation. Workload (e) above
  -- (sawVramStripCoOccurrence) now supplies a REAL measured mixed-queue sample instead -- see
  -- run_sw_driver_timing_check.sh's own frame-inequality accounting for how that real figure is used.
  if not IDLE_ONLY then
    if not sawCrossing then
      fail(EXIT_NO_CROSSING_WORKLOAD, "the busy phase never saw sw_col/sw_row change -- no real ownership-crossing was ever observed")
      return
    end
    if not sawFreshArm then
      fail(EXIT_NO_ARM_WORKLOAD, "the busy phase never saw st_active transition 0->nonzero -- no real busy-arm event was ever observed")
      return
    end
    if not sawColCrossing then
      fail(EXIT_NO_COL_CROSSING, "the busy phase never saw sw_col change -- the column (Right) strip orientation was never genuinely exercised")
      return
    end
    -- Deliberately unconditional (not exempted under SKIP_DOWN_LEG): the workload-drop sabotage
    -- demonstration NEEDS this to fire when the row leg is dropped -- that IS the demonstration.
    if not sawRowCrossing then
      fail(EXIT_NO_ROW_CROSSING, "the busy phase never saw sw_row change -- the row (Down) strip orientation was never genuinely exercised")
      return
    end
    if maxCheapCycles >= maxExpensiveCycles then
      fail(EXIT_WORKLOAD_NOT_CHEAPER, string.format(
        "cheap-path max (%.1f cyc) was not cheaper than expensive-path max (%.1f cyc)", maxCheapCycles, maxExpensiveCycles))
      return
    end
    -- Fix round 1 (gates round-1, Task 1): the four new workloads' own evidence checks run BEFORE
    -- the absolute regression ceilings below -- both are real, independent gates and neither is
    -- weakened by this order. The ceilings themselves are RULED (Chris, 2026-09-24; see
    -- EXPENSIVE_CEILING_CYCLES/MAINLINE_CEILING_CYCLES's own comment above), and the ordinary
    -- (non-sabotaged) build passes comfortably under both -- but a ceiling check ahead of these
    -- would still mask a sabotage build's own specific evidence failure behind the same generic
    -- ceiling code every other build already produces -- each sabotage flag needs to keep proving
    -- ITS OWN targeted check still fires, not just that the shared ceiling still trips.
    if EXPECT_ACTOR_WORKLOADS and not sawContactDamage then
      fail(EXIT_NO_CONTACT_DAMAGE, "the busy phase never saw player_iframes go 0 -> IFRAME_TIME -- no real contact damage was ever observed")
      return
    end
    if not sawReleaseFallback then
      fail(EXIT_NO_RELEASE_FALLBACK, "the busy phase never saw sw_axis_pref flip via the release-fallback branch (no frame had a 0->1 flip with no fresh pad_new press)")
      return
    end
    if not sawUnaligned3Screen then
      fail(EXIT_NO_UNALIGNED_3SCREEN, "no column arm's own entering edge (win_row_screen/win_row_local) ever spanned three distinct screen-rows")
      return
    end
    if EXPECT_ACTOR_WORKLOADS and not sawVramStripCoOccurrence then
      fail(EXIT_NO_VRAM_STRIP_COOCCURRENCE, "vram_len was never nonzero at a real NMI entry while st_active was also nonzero that same frame")
      return
    end
    if EXPECT_ROW8 and not sawRow8EightActors then
      fail(EXIT_NO_ROW8_EIGHT_ACTORS, "the busy phase never saw a fresh ROW arm on the Down-target screen with all eight ent_active slots occupied -- workload (b)'s own eight-actor row-arm evidence is missing")
      return
    end
    -- Round-3 gate closure Task 2: absolute regression ceilings -- see EXPENSIVE_CEILING_CYCLES/
    -- MAINLINE_CEILING_CYCLES's own comment above for why these exist alongside the relative checks.
    if maxExpensiveCycles > EXPENSIVE_CEILING_CYCLES then
      fail(EXIT_EXPENSIVE_REGRESSION, string.format(
        "expensive-path busy max (%.1f cyc) exceeds the absolute regression ceiling (%.1f cyc) -- a uniform per-frame regression can clear every relative check and still be a real regression",
        maxExpensiveCycles, EXPENSIVE_CEILING_CYCLES))
      return
    end
    if maxMainlineBusyCycles > MAINLINE_CEILING_CYCLES then
      fail(EXIT_MAINLINE_REGRESSION, string.format(
        "mainline-busy max (%.1f cyc) exceeds the absolute regression ceiling (%.1f cyc) -- a uniform per-frame regression can clear every relative check and still be a real regression",
        maxMainlineBusyCycles, MAINLINE_CEILING_CYCLES))
      return
    end
    pass(string.format("missing-workload control: cheap-path max %.1f cyc < expensive-path max %.1f cyc (busy max %.1f, idle max %.1f)",
      maxCheapCycles, maxExpensiveCycles, maxBusyCycles, maxIdleCycles))
    pass(string.format("workload evidence: crossing observed=%s, fresh arm observed=%s", tostring(sawCrossing), tostring(sawFreshArm)))
    pass(string.format("mainline span: busy max %.1f cyc, idle max %.1f cyc", maxMainlineBusyCycles, maxMainlineIdleCycles))
    pass(string.format("workload (a)/(c)/(d)/(e) evidence: contact damage=%s, release fallback=%s, unaligned 3-screen=%s, vram/strip co-occurrence=%s",
      tostring(sawContactDamage), tostring(sawReleaseFallback), tostring(sawUnaligned3Screen), tostring(sawVramStripCoOccurrence)))
    pass(string.format("workload (b) evidence (EXPECT_ROW8=%s): row8 eight-actor row arm=%s", tostring(EXPECT_ROW8), tostring(sawRow8EightActors)))
  end
  local reportLabel, reportCycles, scale
  if IDLE_ONLY then
    local avgIdleCycles = sumIdleCycles / math.max(1, idleFrameCount)
    pass(string.format("idle-only: max %.1f cyc, average %.2f cyc over %d frames (avg is what the extra-cost control reads -- a uniform per-frame defect can be cheaper than a legitimate rare peak and hide from a max-only metric)",
      maxIdleCycles, avgIdleCycles, idleFrameCount))
    reportLabel, reportCycles, scale = "idle-only-avg", avgIdleCycles, IDLE_AVG_SCALE
  elseif REPORT_METRIC == "cheap" then
    reportLabel, reportCycles, scale = "cheap-path", maxCheapCycles, MARGIN_SCALE
  elseif REPORT_METRIC == "mainline" then
    reportLabel, reportCycles, scale = "mainline-busy", maxMainlineBusyCycles, MAINLINE_MARGIN_SCALE
  elseif REPORT_METRIC == "nmi" then
    reportLabel, reportCycles, scale = "nmi-busy-max", maxNmiCycles, NMI_MARGIN_SCALE
  elseif REPORT_METRIC == "nmi-max-len" then
    reportLabel, reportCycles, scale = "nmi-max-observed-vram-len", maxObservedVramLen, 1
  else
    reportLabel, reportCycles, scale = "expensive-path", maxExpensiveCycles, MARGIN_SCALE
  end
  local code = math.min(EXIT_PASS_MAX, EXIT_PASS_BASE + math.floor(reportCycles / scale))
  pass(string.format("%s max %.1f cycles -> exit code %d (decode: (code-%d)*%d <= cycles < (code-%d+1)*%d)",
    reportLabel, reportCycles, code, EXIT_PASS_BASE, scale, EXIT_PASS_BASE, scale))
  emu.stop(code)
end

local function onMainLoopReady()
  onMainLoopReadyMeasure()
  if phase ~= "boot" then return end
  if frame > 400 then
    fail(EXIT_NO_BOOT, "never reached ST_GAMEPLAY within 400 frames")
    return
  end
  if read(GAME_STATE) ~= ST_GAMEPLAY then return end
  if read(MAP_IS_STREAMED) == 0 then
    fail(EXIT_NOT_STREAMED, "map_is_streamed is 0 after boot -- the landing screen never engaged streaming")
    return
  end
  phaseStartFrame = frame
  if IDLE_ONLY then
    pass("boot reached ST_GAMEPLAY on a streamed map -- extra-cost control: idle phase only, no input ever held")
    phase = "idle"
    held = {}
  elseif ALIGN_LANDING_Y then
    pass("boot reached ST_GAMEPLAY on a streamed map -- ALIGN_LANDING_Y: skipping pre_down, going straight to busy phase leg 1")
    phase = "busy_right"
    held = SKIP_RELEASE_FALLBACK and { right = true } or { right = true, down = true }
  else
    -- Fix round 1 (gates round-1, Task 1) workload (d): a short pre-phase, holding Down alone,
    -- BEFORE the measured busy phases begin -- see PRE_DOWN_FRAMES above for why this is needed
    -- (win_row_local is hardcoded to 0 at landing; only a real sw_win_row_inc step, reached only
    -- via a genuine row arm, moves it away from that aligned value).
    pass("boot reached ST_GAMEPLAY on a streamed map -- starting pre_down phase (holding Down alone)")
    phase = "pre_down"
    held = { down = true }
  end
end

local function onFrame()
  frame = frame + 1
  if frame > TIMEOUT_FRAMES then
    fail(EXIT_TIMEOUT, "timed out in phase " .. phase)
    return
  end

  if phase == "boot" then
    return
  end

  if phase == "pre_down" then
    if frame - phaseStartFrame >= PRE_DOWN_FRAMES then
      phaseStartFrame = frame
      if SKIP_RELEASE_FALLBACK then
        pass("pre_down complete -- starting busy phase, leg 1 (holding Right only -- SKIP_RELEASE_FALLBACK sabotage)")
        phase = "busy_right"
        held = { right = true }
      else
        -- Fix round 1 (gates round-1, Task 1) workload (c): Down is held ALONGSIDE Right from
        -- frame 1 of leg 1 -- it was already held continuously through pre_down, so this is not a
        -- fresh press (X still wins any tie regardless, engine/streamworld.asm:3287-3292, so leg
        -- 1's own walk stays pure-X, unaffected). Down stays continuously held, never released,
        -- all the way through leg 1. The leg1->leg2 boundary below (unchanged: `held = { down =
        -- true }`) then drops ONLY Right -- since Down was already held (not a fresh press), this
        -- is a genuine release-fallback handoff, not the fresh-press path a bare Right-then-Down
        -- sequence would trigger.
        pass("pre_down complete -- starting busy phase, leg 1 (holding Right+Down together)")
        phase = "busy_right"
        held = { right = true, down = true }
      end
    end
    return
  end

  if phase == "busy_right" then
    if frame - phaseStartFrame >= FRAME_BUSY_LIMIT_RIGHT then
      if SKIP_DOWN_LEG then
        pass("busy leg 1 (Right) complete -- SKIP_DOWN_LEG: workload-drop sabotage, going straight to idle without leg 2 (Down)")
        phase = "idle"
        phaseStartFrame = frame
        held = {}
      else
        pass("busy leg 1 (Right) complete -- release-handoff straight to leg 2 (Down), no idle gap")
        phase = "busy_down"
        phaseStartFrame = frame
        held = { down = true }
      end
    end
    return
  end

  if phase == "busy_down" then
    if frame - phaseStartFrame >= FRAME_BUSY_LIMIT_DOWN then
      pass("busy leg 2 (Down) complete -- starting idle phase (no input)")
      phase = "idle"
      phaseStartFrame = frame
      held = {}
    end
    return
  end

  if phase == "idle" then
    if frame - phaseStartFrame >= FRAME_IDLE_LIMIT then
      finish()
    end
    return
  end
end

emu.addEventCallback(onFrame, emu.eventType.endFrame)
emu.addEventCallback(onInput, emu.eventType.inputPolled)
emu.addMemoryCallback(onMainLoopReady, emu.callbackType.exec, MAIN_LOOP_READY)
emu.addMemoryCallback(onMainLoopBodyStartEntry, emu.callbackType.exec, MAIN_LOOP_BODY_START)
emu.addMemoryCallback(onUpdatePlayerEntry, emu.callbackType.exec, UPDATE_PLAYER)
emu.addMemoryCallback(onMainLoopAfterPlayerEntry, emu.callbackType.exec, MAIN_LOOP_AFTER_PLAYER)
emu.addMemoryCallback(onNmiEntry, emu.callbackType.exec, NMI)
emu.addMemoryCallback(onNmiRtiExit, emu.callbackType.exec, NMI_RTI)
