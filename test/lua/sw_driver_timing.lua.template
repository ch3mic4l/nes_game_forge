-- REPORT_METRIC: which internal counter finish() encodes into the exit code.
--   "expensive" (default) -- driver span, busy-phase crossing-or-fresh-arm max. The main obligation-1
--     headline the old frame-bound estimate is recomputed from.
--   "cheap" -- driver span, the true no-crossing/no-fresh-arm floor (pooled across both phases) --
--     run_sw_driver_timing_check.sh's own extra-cost control compares this against a
--     --break=unconditional-arm build's own idle-only max.
--   "mainline" -- mainline span, busy-phase max (whichever leg). Fix round 2's own new metric --
--     the real whole-frame game-logic cost (including the 8/4 real chasers' own update_entities AI),
--     what the frame inequality (mainline + worst NMI < 29,780 cyc) is recomputed from.
local REPORT_METRIC = "__REPORT_METRIC__"

-- Fix round 2 (finding D/ruling M): the mainline span (unlike the driver span) genuinely straddles
-- a PPU frame boundary -- wait_vblank returns near the START of vblank, and the rest of the frame's
-- own game logic (read_pad..draw_ui) legitimately keeps running past the end of that vblank, into
-- the NEXT PPU frame's own visible scanlines (completely ordinary NES programming: the CPU is never
-- idle). scanline*DOTS_PER_SCANLINE+cycle resets every PPU frame, so a span crossing that reset
-- produces a negative, silently-discarded delta (found empirically: maxMainlineBusyCycles never
-- left 0 against this exact fixture until this fix, and the driver span's own old scanline/dot
-- figure -- 15,150-15,500 cyc -- turned out to be quietly wrong too, for a frame busy enough that
-- even the SHORTER driver span sometimes straddles the boundary). emu.getState()["masterClock"] is
-- monotonic across frame boundaries (Mesen's own DisplayState.lua example script lists it) and,
-- calibrated empirically against this exact build (onFrame-to-onFrame delta measured directly: a
-- clean 29,780-29,781 every time, exactly the known NTSC CPU-cycles-per-frame figure, not the
-- ~357,366 a raw 21.477 MHz master-clock-tick count would give) is ALREADY reported in whole CPU
-- cycles, not master-clock ticks -- no division needed. Replaces the scanline/dot reconstruction
-- outright rather than patching around the wrap.
local CPU_CYCLES_PER_MASTER_CLOCK_UNIT = 1

local EXIT_TIMEOUT               = 99
local EXIT_NO_BOOT               = 2
local EXIT_NOT_STREAMED          = 3
local EXIT_NO_CROSSING_WORKLOAD  = 4  -- BUSY phase never saw sw_col/sw_row change
local EXIT_NO_ARM_WORKLOAD       = 5  -- BUSY phase never saw a fresh (0->nonzero) st_active arm
local EXIT_WORKLOAD_NOT_CHEAPER  = 6  -- IDLE phase's own max was not markedly cheaper than BUSY's
local EXIT_NO_RESPAWN_EVIDENCE   = 7  -- a crossing frame's own ent_active sum did not change --
